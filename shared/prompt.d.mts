import type { DirectorProject, Shot } from './director.mjs';
export type StyleTags = { movement: string[]; cuts: string[]; lens: string[]; filter: string[] };
export type Segment = { key: string; label: string; source: string; color: string; text: string; ids?: string[] };
export const CAMERA_TERMS: Record<keyof StyleTags, string[]>;
export const CAMERA_GROUPS: Record<keyof StyleTags, string>;
export const FIELD_COLORS: Record<string, string>;
export function suggestedStyle(shot: Shot): StyleTags;
export function normalizeStyle(s: unknown): StyleTags;
export function shotStyle(shot: Shot): StyleTags;
export const KIND_COLORS: Record<string, string>;
export function objectColors(project: DirectorProject, shot: Shot): Map<string, string>;
export const VIDEO_PROMPT_CAP: number;
export function sentence(text: string): string;
export type PromptOptions = { cameraSource?: 'blockout' | 'keyframes' | 'still'; cap?: number };
export function autoPromptSegments(project: DirectorProject, shot: Shot, kind?: 'video' | 'image', options?: { cap?: number } & PromptOptions): Segment[];
export function autoPromptText(project: DirectorProject, shot: Shot, kind?: 'video' | 'image', opts?: PromptOptions): string;
export type SectionPolicy = 'inherit' | 'override' | 'lock';
export type SectionRow = Segment & { autoText: string; fullText: string; policy: SectionPolicy; active: boolean; status: 'included' | 'shortened' | 'omitted' | 'removed' | 'orphan'; basedOn?: string; at?: string };
export function sectionedSegments(project: DirectorProject, shot: Shot, kind?: 'video' | 'image', opts?: PromptOptions): SectionRow[];
export function composedPromptText(project: DirectorProject, shot: Shot, kind?: 'video' | 'image', opts?: PromptOptions): string;
export function shotPrompt(project: DirectorProject, shot: Shot, kind?: 'video' | 'image', opts?: PromptOptions): string;
export function highlightRanges(text: string, segments: Segment[]): { start: number; end: number; seg: Segment }[];
export function normalizePrompts(p: unknown): Partial<Record<'video' | 'image', { text: string; edited: true; basedOn: string; editedAt: string }>>;
