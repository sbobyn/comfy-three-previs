import type { DirectorProject, Shot } from './director.mjs';
export type FidelityRoute = 'edit' | 'control' | 'start-end' | 'start';
export type FidelityDirection = 'follows' | 'mixed' | 'approximate';
export type Fidelity = { route: FidelityRoute; routeLabel: string; direction: FidelityDirection; label: string; note: string; tested: boolean; heuristic: true; basis: string };
type DefLike = { id: string; title?: string; inputs?: Record<string, unknown>; provenance?: { presetId?: string }; constraints?: any; pricing?: { ratePerSecond?: number } } | null | undefined;
export const VIDEO_FIDELITY: Record<string, { route: FidelityRoute; direction: FidelityDirection; tested: boolean; note: string }>;
export const ROUTE_LABELS: Record<FidelityRoute, string>;
export const DIRECTION_LABELS: Record<FidelityDirection, string>;
export const DIRECTION_ANGLES: Record<string, number>;
export function blockoutFidelity(def: DefLike): Fidelity;
export function fidelityRank(def: DefLike): number;
export function directionWord(angle: number | null | undefined): string | null;
export function directionPhrase(word: string | null | undefined): string;
export type DirectionSample = { t: number; subject: { id: string; name: string } | null; heading?: number | null; facing?: string | null; travel?: number | null; travelWord?: string | null; speed?: number; size?: number; x?: number; coverage?: number };
export function subjectDirection(project: DirectorProject, shot: Shot, t: number, subjectId?: string | null): DirectionSample;
export type ShotMotion = { subject: { id: string; name: string } | null; samples: { t: number; facing: string | null; heading: number | null; travel: string | null }[]; facesAway: number; turn: number; distance: number; lengths: number; level: 'high' | 'normal'; reasons: string[] };
export function shotMotion(project: DirectorProject, shot: Shot, opts?: { samples?: number }): ShotMotion;
export type FidelityAdvice = { critical: boolean; flagged: boolean; auto: boolean; reasons: string[]; subject: { id: string; name: string } | null; motion: Pick<ShotMotion, 'level' | 'facesAway' | 'turn' | 'distance' | 'lengths' | 'samples'>; model: (Fidelity & { id: string; title: string }) | null; ok: boolean; recommend: (Fidelity & { id: string; title: string }) | null; message: string; heuristic: true };
export function fidelityAdvice(project: DirectorProject, shot: Shot, def: DefLike, defs?: any[], motion?: ShotMotion): FidelityAdvice;
export function defaultForShot<T extends DefLike>(project: DirectorProject, shot: Shot, defs: T[]): T | null;
