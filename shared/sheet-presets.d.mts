import type { Kind } from './director.mjs';
export type SlotSpec = { framing: string; angle: string; pose?: string; expression?: string; intensity?: string | null; mouth?: boolean; detail?: string; view?: string; direction?: string };
export type PlannedSlot = { id: string; label: string; spec: SlotSpec };
export type SheetAttempt = { id: string; requestId: string | null; referenceId: string | null; mode: 'generate' | 'retry' | 'edit'; note: string; from: string | null; presetId: string; seed: number; error: string; createdAt: string };
export type SheetSlot = PlannedSlot & { attempts: SheetAttempt[]; selected: string | null; accepted: string | null };
export type Sheet = { id: string; setId: string; label: string; options: Record<string, any>; presetId: string; createdAt: string; slots: SheetSlot[] };
export type SheetSet = { id: string; kinds: Kind[]; label: string; hint: string; layout: 'turnaround' | 'full' | 'expressions'; options?: Record<string, any> };
export const MAX_SHEET_SLOTS: number;
export const SUBJECT: Record<string, string>;
export const ANGLE_LABELS: Record<string, string>;
export const FRAMINGS: Record<string, { label: string; text: string; aspect: string; layout: 'body' | 'tile' | 'wide' }>;
export const INTENSITIES: Record<string, { label: string; text: string }>;
export const EXPRESSION_PACKS: { id: string; label: string; hint: string; emotions: string[]; mouth?: boolean }[];
export const SHEET_SETS: SheetSet[];
export function anglesFor(kind: string): Record<string, string>;
export function setsFor(kind: string): SheetSet[];
export function setDef(id: string): SheetSet | null;
export function planSlots(setId: string, kind: string, options?: Record<string, any>): PlannedSlot[];
export function expressionSlots(o: { pack?: string; intensities?: string[]; angle?: string }): PlannedSlot[];
export function slotAspect(spec: SlotSpec, kind: string): '1:1' | '3:4' | '4:3' | '16:9';
export function slotLayout(spec: SlotSpec): 'body' | 'tile' | 'wide';
export function viewPrompt(o: { kind: string; spec: SlotSpec; description?: string; styleNotes?: string; projectStyle?: string; note?: string; hasReference?: boolean }): string;
export function editViewPrompt(o: { kind: string; instruction: string; styleNotes?: string; projectStyle?: string; hasIdentity?: boolean }): string;
export function normalizeSheets(value: unknown): Sheet[] | null;
export function slotPick(s: SheetSlot): SheetAttempt | null;
