import type { DirectorProject, Shot, Reference } from './director.mjs';
export type KeyRole = 'start' | 'end' | 'middle';
export type KeyState = 'missing' | 'stale' | 'ready';
export type StillFrame = { index: number; t: number; exact: boolean; override: boolean };
export type KeyRow = { role: KeyRole; ref: Reference | null; state: KeyState; index: number | null; t: number | null; frame: StillFrame | null; outOfRange?: boolean };
export type MiddleSlot = KeyRow & { slot: number; atSeconds: number; blockoutSeconds: number; driftSeconds: number };
export type KeyframePlan = { frames: number; fps: number; outputSeconds: number; start: KeyRow | null; end: KeyRow | null; middle: MiddleSlot[]; unused: (KeyRow & { why: string })[]; warnings: string[]; evenFrames: number[]; spacing: string | null };
export const FPS: number;
export const MAX_MIDDLE: number;
export const TIMED_KEYFRAMES: Record<string, { input: string; max: number; spacing: string; checkedAt: string }>;
export function frameCount(project: DirectorProject, shot: Shot): number;
export function lastFrame(project: DirectorProject, shot: Shot): number;
export function frameTime(i: number): number;
export function momentSeconds(i: number): number;
export function resolveFrame(project: DirectorProject, shot: Shot, o?: { at?: string | number | null; frame?: number | null }): { index: number; t: number; count: number; role: KeyRole; frameAt: 'start' | 'end' | number };
export function stillFrame(project: DirectorProject, shot: Shot, ref: Reference | null | undefined): StillFrame | null;
export function middleKeys(shot: Shot): number[];
export function takeAt(project: DirectorProject, shot: Shot, index: number): Reference | null;
export function keyframeState(project: DirectorProject, shot: Shot): { count: number; start: KeyRow; end: KeyRow; middle: KeyRow[] };
export function middleFrameTarget(definition: any): { nodeId: string; spec: { input: string; max: number; spacing: string } } | null;
export function maxMiddleFrames(definition: any): number;
export function withMiddleFrames<T>(definition: T, count: number): T;
export function evenFrames(n: number, count: number): number[];
export function keyframePlan(project: DirectorProject, shot: Shot, definition: any, o?: { seconds?: number | null }): KeyframePlan;
export function frameLabel(i: number): string;
export function applyKeyframeOp(p: DirectorProject, op: any, o: { resolveShot: (p: DirectorProject, ref: string) => Shot | null; newId: () => string; now: () => string }): any;
