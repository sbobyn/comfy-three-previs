{
  "name": "comfy-three-previs",
  "version": "0.1.0",
  "description": "Open-source AI previs: 3D blockouts, consistent cast images, gamepad & phone camera, AI video.",
  "author": "Steven Bobyn",
  "homepage": "https://sbobyn.github.io/comfy-three-previs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sbobyn/comfy-three-previs.git"
  },
  "bugs": {
    "url": "https://github.com/sbobyn/comfy-three-previs/issues"
  },
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "bootstrap": "pnpm install --frozen-lockfile && pnpm run build && pnpm run doctor",
    "doctor": "node --env-file-if-exists=.env scripts/doctor.mjs",
    "prestart": "node scripts/doctor.mjs --quick",
    "start": "node --env-file-if-exists=.env server/previs/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev": "pnpm build && pnpm start",
    "build": "vite build && vite build --config vite.server.config.ts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm build",
    "dev:camera": "vite --host 127.0.0.1 --port 5187",
    "docs:models": "node scripts/models-table.mjs",
    "usage:report": "node --env-file-if-exists=.env scripts/usage-report.mjs",
    "usage:settle": "node --env-file-if-exists=.env scripts/usage-settle.mjs",
    "starters:export": "node scripts/export-starters.mjs",
    "starters:import": "node scripts/import-starters.mjs",
    "lint:blockouts": "node scripts/blender/lint-blockouts.mjs",
    "demo:build": "VITE_DEMO=1 vite build --base=/comfy-three-previs/ --outDir dist-demo --emptyOutDir && node scripts/snapshot-demo.mjs",
    "demo:local": "bash scripts/demo-local.sh"
  },
  "devDependencies": {
    "@types/node": "^26.6.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "axe-core": "4.14.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "three": "0.187.0",
    "ws": "^8.21.3"
  },
  "optionalDependencies": {
    "playwright-core": "1.64.1"
  },
  "license": "MIT"
}
