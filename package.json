{
  "name": "comfy-previs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "start": "node server/previs/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev": "pnpm build && pnpm start",
    "build": "vite build && vite build --config vite.server.config.ts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm build",
    "dev:camera": "vite --host 127.0.0.1 --port 5187"
  },
  "devDependencies": {
    "@types/node": "^26.6.0",
    "@types/three": "^0.185.0",
    "@types/ws": "^8.18.1",
    "prettier": "3.6.2",
    "three": "0.185.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "ws": "^8.21.3"
  }
}
