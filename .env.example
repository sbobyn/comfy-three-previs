# Copy to .env beside package.json (cp .env.example .env). pnpm start/dev/doctor load it.
# .env is gitignored. Keep credentials here only — never in graphs, projects or chat.
# Existing shell environment variables take precedence. Restart after changes.

# Comfy Cloud API key (comfy.org). Enables free quotes; generation still needs approval.
COMFY_CLOUD_API_KEY=
# Paid execution switch. Keep 0 until you have reviewed a quote you want to run.
PREVIS_ALLOW_PAID=0

# Budget (see README "Budget"). Caps in USD; unset = no cap. Unpriced models are refused unless PREVIS_ALLOW_UNKNOWN_COST=1.
# PREVIS_BUDGET_CAP_USD=          # account, per PREVIS_BUDGET_PERIOD (month by default; day or all)
# PREVIS_BUDGET_PROJECT_CAP_USD=  # each project, all time
# PREVIS_ALLOW_UNKNOWN_COST=0
# PREVIS_BUDGET_PERIOD=month
# PREVIS_BUDGET_TZ=               # time zone for day/month periods (default: this machine's)
# PREVIS_BUDGET_RESERVATION_TTL_HOURS=24
# PREVIS_BUDGET_DIR=              # shared ledger for several servers (default PREVIS_DATA_DIR/budget)

# Optional:
# PORT=5190
# PREVIS_DATA_DIR=            # project folder (default .previs in the checkout)
# PREVIS_COMFY_URL=http://127.0.0.1:8000   # local ComfyUI
# COMFY_API_KEY=              # comfy.org key for partner nodes on local ComfyUI
# PREVIS_FFMPEG=              # full path if ffmpeg is not on PATH
# PREVIS_FFPROBE=
# PREVIS_BLENDER_MCP_COMMAND=
# PREVIS_BLENDER_MCP_ARGS=
# BLENDER_HOST=
# BLENDER_PORT=
# Phone camera over HTTPS (see README "Phone camera"):
# PREVIS_PHONE_HOST=
# PREVIS_PHONE_PORT=
# PREVIS_PHONE_CERT=
# PREVIS_PHONE_KEY=
# PREVIS_PHONE_CA=
