# Copy to .env beside package.json; pnpm start/dev load it on startup.
# .env is gitignored. Keep credentials here, never in graphs or projects.
# Existing shell environment variables take precedence. Restart after changes.
COMFY_CLOUD_API_KEY=
# Adding a key does not authorize generation. Keep paid execution disabled
# until a request has been reviewed and its spending explicitly approved.
PREVIS_ALLOW_PAID=0

# Other optional server settings:
# PREVIS_DATA_DIR=
# PORT=
# PREVIS_BLENDER_MCP_COMMAND=
# PREVIS_BLENDER_MCP_ARGS=
# BLENDER_HOST=
# BLENDER_PORT=
# PREVIS_FFMPEG=
# PREVIS_FFPROBE=
# PREVIS_COMFY_URL=
# COMFY_API_KEY=
